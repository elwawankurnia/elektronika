/*-----( Masukan Library yang dibutuhkan )-----*/
#include <Wire.h>  // Comes with Arduino IDE
#include <LCD.h>
#include <LiquidCrystal_I2C.h>

// Konfigurasi LCD address ke 0x3F untuk tampilan 20 karakter dan 4 baris
// Atur pin pada I2C chip untuk koneksi ke LCD:
// addr, en,rw,rs,d4,d5,d6,d7,bl,blpol
LiquidCrystal_I2C lcd(0x27, 2, 1, 0
int Turbidity_Sensor_Pin = A0;, 4, 5, 6, 7, 3, POSITIVE);  // Atur LCD I2C address

float Turbidity_Sensor_Voltage;
int samples = 600;
float ntu; // Nephelometric Turbidity Units


void setup()   //----( SETUP: BERJALAN SEKALI )----
{
  Serial.begin(9600);  // Mengaktifkan serial
  pinMode(Turbidity_Sensor_Pin, INPUT);
  lcd.backlight();            //Aktifasi backlight     
  lcd.home();  
  lcd.begin(20, 4);        // inisialisasi LCD dengan 20 karakter dan 4 baris
  
  // ------- Melakukan blink 3 kali (Opsional) -------------
  for (int i = 0; i < 3; i++)
  {
    lcd.backlight();
    delay(100);
    lcd.noBacklight();
    delay(100);
  }
  lcd.backlight(); // Diakhiri dengan backlight on

  //-------- Menulis/menampilkan karakter pada LCD ------------------
  // CATATAN: Posisi Kursor: Baris dan Karakter mulai pada 0
  lcd.setCursor(0, 0); //Huruf akan mulai pada karakter ke 4 dan baris 0 pada LCD
  lcd.print("HUSEINTEKNIK INOVATION");
  delay(500);
  lcd.setCursor(0, 1);
  lcd.print("TURBID IDENTIFICATOR");
  delay(500);
  lcd.setCursor(0, 2);
  lcd.print("MENGUJI KEKERUHAN CAIRAN ATAU FLUIDA");
  lcd.setCursor(0, 3);
  delay(500);
  lcd.print("@WAWANKURNIA.RTX");
  delay(500); // Tunggu selama 8 detik untuk dapat mengetik karakter pada serial monitor
  lcd.setCursor(0, 2); //Mulai dari Karakter 0 dan baris 0
  lcd.print("MULAI SERIAL MONITOR");
  lcd.setCursor(0, 3);
  lcd.print("INPUT DATA 2 DISPLAY");


}/*--(end setup )---*/


void loop()   /*----( LOOP: DIEKSEKUSI TERUS MENERUS )----*/
{
Turbidity_Sensor_Voltage = 0;
    /*  take the average value
     *  take 600 samples
     */
    for(int i=0; i<samples; i++)
    {
        Turbidity_Sensor_Voltage += ((float)analogRead(Turbidity_Sensor_Pin)/1023)*5;
    }
    
    Turbidity_Sensor_Voltage = Turbidity_Sensor_Voltage/samples;
    // komentar pada dua pernyataan berikut untuk memeriksa tegangan. 
    //Serial.println("Voltage:");
    //Serial.println(Turbidity_Sensor_Voltage);
    // jika Anda menemukan adanya perbedaan, ambil langkah-langkah yang diperlukan untuk memperbaikinya
    // Setelah Anda puas dengan nilai tegangannya, Anda dapat mengomentari baris-baris ini kembali
         
    Turbidity_Sensor_Voltage = round_to_dp(Turbidity_Sensor_Voltage,2);
    if(Turbidity_Sensor_Voltage < 2.5){
      ntu = 3000;
    }else{
      ntu = -1120.4*square(Turbidity_Sensor_Voltage)+ 5742.3*Turbidity_Sensor_Voltage - 4352.9; 
    }
    lcd.clear();
    lcd.setCursor(0,0);
    lcd.print(Turbidity_Sensor_Voltage);
    lcd.print(" V");
 
    lcd.setCursor(0,1);
    lcd.print(ntu);
    lcd.print(" NTU");
    delay(10);
  
if (ntu=3000)  {
                              lcd.setCursor(0, 2);
                              lcd.print("TIDAK ADA PARTIKEL TERBACA);
                              lcd.setCursor(0, 3);
                              lcd.print("CAIRAN BAIK");  
}
else if (2000<ntu<3000)  {
                              lcd.setCursor(0, 2);
                              lcd.print("PARTIKEL TERBACA");
                              lcd.setCursor(0, 3);
                              lcd.print("CONT XX GR/ML");  //----GUNAKAN SIMULASI BEBERAPA BOTOL CAIRAN YANG DIBERIKAN KONTAMINAN DALAM NILAI GRAM/MILILITER
}
else if (1000<ntu<2000)  {
                              lcd.setCursor(0, 2);
                              lcd.print("PARTIKEL TERBACA");
                              lcd.setCursor(0, 3);
                              lcd.print("CONT XX GR/ML");  
}
else if (500<ntu<1000)  {
                              lcd.setCursor(0, 2);
                              lcd.print("PARTIKEL TERBACA");
                              lcd.setCursor(0, 3);
                              lcd.print("CONT XX GR/MLl");  
}
else {
                              lcd.setCursor(0, 2);
                              lcd.print("PARTIKEL TERBACA");
                              lcd.setCursor(0, 3);
                              lcd.print("CAIRAN BURUK");  
}

       
}
 
float round_to_dp( float in_value, int decimal_place )
{
  float multiplier = powf( 10.0f, decimal_place );
  in_value = roundf( in_value * multiplier ) / multiplier;
  return in_value;
}


/* --(end main loop )-- */
